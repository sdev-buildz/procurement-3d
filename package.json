{
  "name": "full-stack-template",
  "version": "0.0.0",
  "description": "Template for full stack applications. Includes TypeScript, ReactJS, Node.js, GraphQL, and Prisma.",
  "type": "module",
  "scripts": {
    "start-server": "pnpm --filter=./packages/procurement run start-server",
    "start-server:watch": "pnpm --filter=./packages/procurement run start-server:watch",
    "start-react:watch": "pnpm --filter=./packages/procurement run start-react:watch",
    "build:embed": "pnpm --filter=./packages/embed run build",
    "start-embed:watch": "pnpm --filter=./packages/embed run start-react:watch",
    "build:react": "pnpm --filter=./packages/procurement run build:react",
    "build:gql-types": "pnpm --filter=./packages/db --filter=./packages/procurement run build:gql-types",
    "check": "turbo turbo-build prettier:check lint type-check coverage:ci knip:ci e2e:ci",
    "check:lite": "turbo turbo-build prettier:check lint type-check coverage:ci knip:ci",
    "build": "turbo turbo-build",
    "build:main": "pnpm --filter=./packages/procurement run build:react",
    "unit-tests": "vitest",
    "coverage": "vitest --coverage --ui",
    "coverage:ci": "vitest run --coverage",
    "clean": "pnx rimraf -g **/dist **/dist-tsc **/*.tsbuildinfo  **/generated **/*.graphql **/.turbo coverage docs",
    "clean:all": "pnpm run clean && pnx rimraf -g **/node_modules",
    "type-check": "tsc --build",
    "lint": "eslint",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "prettier:pnpm-lock": "prettier --write **/pnpm-lock.yaml",
    "e2e": "playwright test --trace on",
    "e2e:ci": "playwright install --with-deps && playwright test",
    "knip:main": "knip --workspace !packages/web-app-utils",
    "knip:e2e-app": "knip --workspace packages/web-app-utils",
    "knip": "pnpm run knip:main & pnpm run knip:e2e-app",
    "knip:ci": "pnpm run knip:main && pnpm run knip:e2e-app",
    "docs": "typedoc --options typedoc.config.js",
    "docs:turbo": "turbo docs",
    "docs:ci": "pnpm run build && pnpm run docs",
    "docker:compose-up": "docker compose --env-file ./packages/db/.env up",
    "prisma:seed": "pnpm --filter=@packages/db run prisma:seed",
    "prisma:generate": "pnpm --filter=@packages/db run prisma:generate",
    "prisma:migrate-dev:create-only": "pnpm --filter=@packages/db run prisma:migrate-dev:create-only",
    "prisma:migrate-dev": "pnpm --filter=@packages/db run prisma:migrate-dev",
    "prisma:migrate-prod": "pnpm --filter=@packages/db run prisma:migrate-prod",
    "prisma:migrate-reset": "pnpm --filter=@packages/db run prisma:migrate-reset"
  },
  "private": true,
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@packages/web-app-utils": "workspace:*",
    "@playwright/test": "^1.57.0",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-jsdoc": "^64.3.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-naming-convention": "^5.18.7",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "typescript-eslint": "^8.69.0",
    "vitest": "catalog:"
  }
}
