{
  "$schema": "https://turborepo.dev/schema.json",

  "tasks": {
    "//#prettier:check": {
      "dependsOn": ["//#turbo-build"]
    },
    "//#lint": {},

    "//#build:main": {
      "description": "bundles the web-client.",
      "outputs": ["./packages/procurement/dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.github/**",
        "!.vscode/**",
        "!.changeset/**",
        "!e2e/**",
        "!*.md",
        "!**/*.graphql"
      ]
    },
    "prisma:generate": {
      "description": "Generates the Prisma client and Pothos types.",
      "outputs": ["generated/**"]
    },
    "//#build:gql-types": {
      "description": "Generates GraphQL types through the root build script.",
      "dependsOn": ["@packages/db#prisma:generate"],
      "outputs": [
        "packages/web-app/generated/**",
        "packages/web-app/schema.graphql"
      ]
    },

    "//#prettier:pnpm-lock": {
      "description": "Formats pnpm-lock.yaml file.",
      "dependsOn": ["//#build:main", "//#build:gql-types"],
      "outputs": ["pnpm-lock.yaml"],
      "inputs": ["pnpm-lock.yaml"]
    },

    "//#turbo-build": {
      "description": "Performs all the build tasks.",
      "dependsOn": [
        "//#build:main",
        "//#build:gql-types",
        "//#prettier:pnpm-lock"
      ],
      "outputs": ["./packages/procurement/dist/**"]
    },

    "//#dev": {
      "dependsOn": ["^dev"]
    },

    "//#type-check": {
      "description": "Checks the TypeScript types.",
      "dependsOn": ["//#turbo-build"],
      "outputs": ["**/dist-tsc/**"]
    },

    "//#coverage": {
      "dependsOn": ["//#turbo-build"],
      "outputs": ["./coverage/**"],
      "persistent": true
    },
    "//#coverage:ci": {
      "dependsOn": ["//#turbo-build"],
      "outputs": ["./coverage/**"]
    },
    "//#knip": {
      "dependsOn": ["//#turbo-build"]
    },
    "//#knip:ci": {
      "dependsOn": ["//#turbo-build"]
    },
    "//#e2e": {
      "dependsOn": ["//#turbo-build"],
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.github/**",
        "!.vscode/**",
        "!.changeset/**",
        "**/*.md"
      ]
    },
    "//#e2e:ci": {
      "dependsOn": ["//#turbo-build"],
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.github/**",
        "!.vscode/**",
        "!.changeset/**",
        "**/*.md"
      ]
    },
    "//#docs": {
      "dependsOn": ["//#turbo-build"],
      "outputs": ["./docs/api-reference"]
    }
  }
}
