# Postgres connection
# When you make any changes to these values, make sure to update the DATABASE_URL variable accordingly.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# The name of the database to connect to. Make sure to create this database (if it doesn't already exist) in your Postgres instance before running the application.
POSTGRES_DB=fs-template



# DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<db-name>"
# DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/<POSTGRES_DB>"
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/fs-template"
 

# MinIO connection
MINIO_ROOT_USER=rootadmin
MINIO_ROOT_PASSWORD=miniopassword